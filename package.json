    "build:gate": "npm run build",
    "approval:program": "node scripts/approval-pipeline-hook.mjs",
    "validate": "node scripts/validate-money-template-p1.mjs && node scripts/validate-program-coverage.mjs && npm run validate:wave4 && npm run validate:approved-53 && npm run validate:ready6",
