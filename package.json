    "validate:instrumentation": "node scripts/validate-instrumentation.mjs",
    "validate:no-overlap": "playwright test tests/browser/consent-no-overlap.spec.mjs",
    "validate:editorial-monetization": "node scripts/validate-editorial-monetization.mjs",
    "validate:lp-speed": "node scripts/validate-lp-speed.mjs",
    "test:copy-preservation": "node artifacts/ultracode/tools/validate-copy-preservation.mjs",
    "test:claim-ledger": "node artifacts/ultracode/tools/validate-claim-ledger.mjs",
    "test:browser-nowrite": "node artifacts/ultracode/tools/test-browser-nowrite.mjs",
    "test:interactions": "node artifacts/ultracode/tools/test-interactions.mjs",
    "test:responsive-matrix": "node artifacts/ultracode/tools/test-responsive-matrix.mjs",
    "test:accessibility": "node artifacts/ultracode/tools/test-accessibility.mjs",
