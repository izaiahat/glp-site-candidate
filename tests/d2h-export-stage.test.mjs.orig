import test from 'node:test';
import assert from 'node:assert/strict';
import {candidateSharedRuntime,candidateExportShellFindings} from '../src/candidate-export-policy.mjs';
const loader="(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-PWR49VVK');";
const shell=`<script>window.GCS_ANALYTICS={enabled:true,consent:'granted'};window.GCS_CLARITY={enabled:false,project_id:null};window.GCS_POSTHOG={"enabled":true};</script><script>${loader}</script>`;
test('candidate default stays held and strips eager vendors',()=>{const h=candidateSharedRuntime(shell,{stage:'candidate'});assert.match(h,/"third_party_exports":false/);assert.match(h,/GCS_ANALYTICS=\{[^}]*enabled:false/);assert.doesNotMatch(h,/googletagmanager\.com\/gtm.js/);assert.deepEqual(candidateExportShellFindings(h,{stage:'candidate'}),[]);});
test('production seal enables configured transport but not unbound Clarity, consent or eager GTM',()=>{const h=candidateSharedRuntime(shell,{stage:'production-seal'});assert.match(h,/"stage":"production-seal"/);assert.match(h,/"third_party_exports":true/);for(const n of ['ANALYTICS','POSTHOG'])assert.match(h,new RegExp('GCS_'+n+'=\\{[^}]*["\\\']?enabled["\\\']?:true'));assert.match(h,/GCS_CLARITY=\{enabled:false,project_id:null/);assert.match(h,/consent:'unknown'/);assert.match(h,/gtm_container_id:'GTM-PWR49VVK'/);assert.doesNotMatch(h,/googletagmanager\.com\/gtm.js/);assert.deepEqual(candidateExportShellFindings(h,{stage:'production-seal'}),[]);assert.ok(candidateExportShellFindings(h,{stage:'candidate'}).length);});
test('invalid release stages fail closed',()=>assert.throws(()=>candidateSharedRuntime(shell,{stage:'prod-ish'}),/release stage/));
test('production missing container identity fails closed',()=>assert.throws(()=>candidateSharedRuntime('<script>window.GCS_ANALYTICS={enabled:false};</script>',{stage:'production-seal'}),/GTM/));
test('arbitrary GTM-related scripts are preserved and rejected, not erased',()=>{const other='<script>window.other="https://www.googletagmanager.com/gtm.js";</script>';const h=candidateSharedRuntime(shell+other,{stage:'production-seal'});assert.ok(h.includes(other));assert.ok(candidateExportShellFindings(h,{stage:'production-seal'}).includes('eager_remote_loader_present'));});
