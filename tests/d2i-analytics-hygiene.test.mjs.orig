import test from 'node:test';
import assert from 'node:assert/strict';
import vm from 'node:vm';
import {readFileSync} from 'node:fs';
import {consentRuntimeSource} from '../src/consent-runtime.mjs';
import {releaseExportPolicy,candidateSharedRuntime,candidateExportShellFindings} from '../src/candidate-export-policy.mjs';
const analytics=readFileSync(new URL('../assets/analytics.js',import.meta.url),'utf8');
// MOCK SDK sinks only. No browser, network, grants outside this isolated context.
export function fixture({url='https://glpclinicscout.com/',gpc=false,webdriver=false,stage='production-seal',saved=null}={}) {
 const location=new URL(url),storage=new Map(saved?[['gcs_tracking_consent_v1',JSON.stringify(saved)]]:[]),scripts=[],captures=[],listeners={},cookies=[];
 const window={location,GCS_EXPORT_POLICY:releaseExportPolicy(stage),GCS_ANALYTICS:{enabled:true,consent:'unknown',measurement_id:'G-MOCK',gtm_container_id:'GTM-MOCK'},GCS_CLARITY:{enabled:false,project_id:null},GCS_POSTHOG:{enabled:true,api_key:'mock-not-a-real-key',host:'https://mock.invalid',operator_gate:'explicit-consent-v3'},addEventListener:(n,f)=>{(listeners[n]??=[]).push(f)},dispatchEvent:e=>{for(const f of listeners[e.type]||[])f(e)}};
 const document={readyState:'loading',referrer:'https://referrer.invalid/intake/?email=CANARY#dose',title:'CANARY clinical title',addEventListener(){},querySelector(){return null},querySelectorAll(){return []},documentElement:{style:{removeProperty(){}},scrollHeight:1000},createElement(){return {listeners:{},addEventListener(n,f){this.listeners[n]=f}}},head:{appendChild:s=>scripts.push(s)},set cookie(v){cookies.push(v)}};
 const context=vm.createContext({window,document,location,navigator:{globalPrivacyControl:gpc,webdriver,userAgent:'Mozilla/5.0'},localStorage:{getItem:k=>storage.get(k)||null,setItem:(k,v)=>storage.set(k,v)},CustomEvent:class{constructor(type,{detail}={}){this.type=type;this.detail=detail}},URL,URLSearchParams});
 vm.runInContext(consentRuntimeSource,context);vm.runInContext(analytics,context);
 return {window,scripts,captures,storage,grant:()=>window.GCSConsent.apply('granted'),mockLoad(){let options;window.posthog={init:(key,o)=>{options=o},capture:(...a)=>captures.push(a),opt_out_capturing:()=>captures.push(['OPT_OUT'])};const s=scripts.find(s=>s.src.includes('array.js'));assert.ok(s,'PostHog bootstrap requested');s.listeners.load();return options}};
}
for(const stage of ['candidate','production-seal'])test('unbound Clarity stays disabled: '+stage,()=>{const h=candidateSharedRuntime(`<script>window.GCS_ANALYTICS={enabled:false,consent:'unknown',gtm_container_id:'GTM-MOCK'};window.GCS_POSTHOG={"enabled":false};window.GCS_CLARITY={enabled:false,project_id:null};</script>`,{stage});assert.match(h,/GCS_CLARITY=\{enabled:false,project_id:null/);assert.deepEqual(candidateExportShellFindings(h,{stage}),[]);assert.ok(candidateExportShellFindings(h.replace('GCS_CLARITY={enabled:false','GCS_CLARITY={enabled:true'),{stage}).includes('clarity_wrong_stage'));});
for(const suffix of ['/?utm_source=CANARY&gclid=CANARY#CANARY','/quiz/provider-fit/?answer=CANARY','/scorecard/','/tools/glp-1-cost-calculator/?dose=CANARY'])test('mock explicit UI grant, sanitized landing '+suffix,()=>{
 const f=fixture({url:'https://glpclinicscout.com'+suffix});assert.equal(f.scripts.length,0);assert.equal(f.window.GCSAnalytics.event('quiz_start',{}),false);f.grant();assert.equal(f.window.GCSConsent.allowsExports(),true);const options=f.mockLoad();
 for(const name of ['quiz_start','quiz_step_complete','quiz_complete','scorecard_start','scorecard_step_view','scorecard_step_complete','scorecard_abandon','scorecard_complete','cost_calculator_used','calculator_submit']) {assert.equal(f.window.GCSAnalytics.event(name,{page_slug:'CANARY',answer:'CANARY',result_count:4,step_id:'dose',step_number:2,treatment:'CANARY',provider:'CANARY'}),true,name);assert.deepEqual(JSON.parse(JSON.stringify(f.captures.at(-1)[1])),{});}
 for(const name of ['results_view','calculator_result_view','cost_calculator_complete','cost_calculator_medication_selected','provider_finder_complete','comparison_facets_changed','dose_selected','$pageview','__proto__','constructor'])assert.equal(f.window.GCSAnalytics.event(name,{treatment:'CANARY'}),false,name);
 assert.equal(options.autocapture,false);assert.equal(options.capture_pageview,false);assert.equal(options.capture_pageleave,false);assert.equal(options.disable_session_recording,true);assert.equal(options.person_profiles,'never');assert.equal(options.persistence,'memory');
 const event=options.before_send({event:'quiz_start',properties:{$current_url:'CANARY',$referrer:'CANARY',distinct_id:'CANARY',answer:'CANARY'}});assert.deepEqual(JSON.parse(JSON.stringify(event.properties)),{});assert.equal(options.before_send({event:'$pageview',properties:{}}),null);
 assert.doesNotMatch(JSON.stringify(f.captures),/CANARY|dose|treatment|result_count/);for(const s of f.scripts)assert.equal(s.referrerPolicy,'no-referrer');
 f.window.GCSConsent.apply('denied');assert.equal(f.window.GCSAnalytics.event('quiz_start'),false);assert.equal(options.before_send({event:'quiz_start',properties:{}}),null);f.grant();assert.equal(f.window.GCSAnalytics.event('quiz_start'),true);
});
for(const [label,args]of [['candidate',{stage:'candidate'}],['GPC',{gpc:true}],['automation',{webdriver:true}],['local',{url:'http://127.0.0.1/'}],['intake',{url:'https://glpclinicscout.com/intake/'}],['results',{url:'https://glpclinicscout.com/results/'}]])test('mock negative gate '+label,()=>{const f=fixture(args);f.grant();assert.equal(f.window.GCSConsent.allowsExports(),false);assert.equal(f.scripts.length,0);assert.equal(f.window.GCSAnalytics.event('quiz_start'),false);assert.equal(f.window.GCSAnalytics.clickIdFor('TEST'),null);const a={href:'https://merchant.invalid/?x=1'};assert.equal(f.window.GCSAnalytics.decorateOutbound(a,'mock-id'),a.href)});
test('legacy grant is not explicit and all four defaults denied',()=>{const f=fixture({saved:{version:'gcs-cookie-v2-default-on',analytics:'granted'}});assert.equal(f.window.GCSConsent.effective(),'denied');assert.equal(f.scripts.length,0);assert.deepEqual(Object.values(f.window.dataLayer[0][2]),['denied','denied','denied','denied']);});
test('pending mock SDK revocation clears historical queue; delayed load cannot initialize denied',()=>{
 const f=fixture();f.grant();f.window.GCSAnalytics.event('quiz_start');assert.equal(f.window.posthog.__queue.length,1);f.window.GCSConsent.apply('denied');assert.equal(f.window.posthog.__queue.length,0);let initialized=false;f.window.posthog.init=()=>{initialized=true};f.scripts.find(s=>s.src.includes('array.js')).listeners.load();assert.equal(initialized,false);assert.equal(f.window.GCS_POSTHOG_LOADED,false);
});
test('all reviewed names export no caller properties or automatic identity, including affiliate events',()=>{
 const f=fixture({url:'https://glpclinicscout.com/?gclid=CANARY#CANARY'});f.grant();const options=f.mockLoad();
 const names=['affiliate_click','comparison_table_view','cost_calculator_used','calculator_submit','quiz_complete','quiz_start','quiz_step_complete','content_upgrade_view','content_upgrade_submit','content_upgrade_success','content_upgrade_complete','scroll_75','scorecard_start','scorecard_step_view','scorecard_step_complete','scorecard_abandon','scorecard_complete','sticky_cta_click','comparison_sort_change'];
 const poison={answer:'CANARY',treatment:'CANARY',dose:'CANARY',provider_slug:'CANARY',page_slug:'CANARY',page_path:'CANARY',subid:'CANARY',cs_click_id:'CANARY',gclid:'CANARY',result_count:999,step_id:'CANARY',step_number:999,__proto__:{email:'CANARY'}};
 for(const name of names){assert.equal(f.window.GCSAnalytics.event(name,poison),true);assert.deepEqual(JSON.parse(JSON.stringify(f.captures.at(-1)[1])),{});const event=options.before_send({event:name,properties:poison,distinct_id:'CANARY',$set:{health:'CANARY'}});assert.deepEqual(JSON.parse(JSON.stringify(event)),{event:name,properties:{}});}
 assert.doesNotMatch(JSON.stringify(f.window.dataLayer),/CANARY|result_count|step_number/);assert.doesNotMatch(JSON.stringify(f.captures),/CANARY|result_count|step_number/);
 f.window.GCS_EXPORT_POLICY={third_party_exports:true};assert.equal(f.window.GCSConsent.allowsExports(),false);assert.equal(f.window.GCSAnalytics.event('quiz_start'),false);
});
