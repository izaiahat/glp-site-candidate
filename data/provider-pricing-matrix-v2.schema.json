{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:glp:provider-pricing-matrix:v2",
  "title": "GLP provider pricing matrix v2, six typed price kinds",
  "type": "object",
  "required": [
    "schema",
    "providers",
    "coverage",
    "migration"
  ],
  "properties": {
    "schema": {
      "const": "glp-provider-pricing-matrix-v2"
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "medications",
          "program_id",
          "provider"
        ],
        "properties": {
          "medications": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/priceRow"
                },
                {
                  "$ref": "#/$defs/legacyRow"
                }
              ]
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object"
    },
    "migration": {
      "type": "object",
      "required": [
        "legacy_snapshot_sha256",
        "legacy_snapshot_path"
      ],
      "properties": {
        "legacy_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "legacy_snapshot_path": {
          "const": "data/pricing-v1-legacy-snapshot.json"
        }
      }
    }
  },
  "$defs": {
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote",
        "capture_path",
        "capture_sha256",
        "captured_at_utc",
        "source_url"
      ],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "capture_path": {
          "type": "string",
          "pattern": "^data/pricing-evidence/[a-f0-9]{64}\\.md$"
        },
        "capture_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "captured_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence",
        "artifact_needed"
      ],
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/witness"
          }
        },
        "artifact_needed": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "artifact_needed": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "evidence": {
                "minItems": 1
              },
              "artifact_needed": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "priceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "medication_id",
        "label",
        "price_kind",
        "plan_label",
        "facts",
        "evidence",
        "identity_evidence",
        "qualifiers",
        "unknown_components",
        "calculator_eligibility"
      ],
      "properties": {
        "row_id": {
          "type": "string",
          "minLength": 3
        },
        "medication_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "price_kind": {
          "enum": [
            "floor_from",
            "prepaid_bundle",
            "monthly_equivalent_of_billing_period",
            "membership_plus_medication",
            "intro_then_ongoing",
            "monthly_cash"
          ]
        },
        "plan_label": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fact"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/witness"
          },
          "minItems": 1
        },
        "identity_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/witness"
          },
          "minItems": 1
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknown_components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "calculator_eligibility": {
          "const": "display_only"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "price_kind": {
                "const": "floor_from"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "required": [
                  "amount_usd",
                  "period"
                ],
                "properties": {
                  "amount_usd": {
                    "properties": {
                      "value": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100000
                      }
                    }
                  },
                  "period": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "price_kind": {
                "const": "prepaid_bundle"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "required": [
                  "amount_usd",
                  "supply_period"
                ],
                "properties": {
                  "amount_usd": {
                    "properties": {
                      "value": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100000
                      }
                    }
                  },
                  "supply_period": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "not": {
                          "const": "UNKNOWN"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "price_kind": {
                "const": "monthly_equivalent_of_billing_period"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "required": [
                  "equivalent_usd",
                  "equivalent_period",
                  "billing_period",
                  "amount_usd"
                ],
                "properties": {
                  "equivalent_usd": {
                    "properties": {
                      "value": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100000
                      }
                    }
                  },
                  "equivalent_period": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "not": {
                          "const": "UNKNOWN"
                        }
                      }
                    }
                  },
                  "billing_period": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "not": {
                          "const": "UNKNOWN"
                        }
                      }
                    }
                  },
                  "amount_usd": {
                    "properties": {
                      "value": {
                        "oneOf": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100000
                          },
                          {
                            "const": "UNKNOWN"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "price_kind": {
                "const": "membership_plus_medication"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "required": [
                  "membership_usd",
                  "membership_period",
                  "medication_usd",
                  "medication_period"
                ],
                "properties": {
                  "membership_usd": {
                    "properties": {
                      "value": {
                        "oneOf": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100000
                          },
                          {
                            "const": "UNKNOWN"
                          }
                        ]
                      }
                    }
                  },
                  "membership_period": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "medication_usd": {
                    "properties": {
                      "value": {
                        "oneOf": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100000
                          },
                          {
                            "const": "UNKNOWN"
                          }
                        ]
                      }
                    }
                  },
                  "medication_period": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "price_kind": {
                "const": "intro_then_ongoing"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "required": [
                  "intro_usd",
                  "intro_period",
                  "ongoing_usd",
                  "ongoing_period"
                ],
                "properties": {
                  "intro_usd": {
                    "properties": {
                      "value": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100000
                      }
                    }
                  },
                  "intro_period": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "not": {
                          "const": "UNKNOWN"
                        }
                      }
                    }
                  },
                  "ongoing_usd": {
                    "properties": {
                      "value": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100000
                      }
                    }
                  },
                  "ongoing_period": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "not": {
                          "const": "UNKNOWN"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "price_kind": {
                "const": "monthly_cash"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "required": [
                  "amount_usd",
                  "period",
                  "cash_schedule"
                ],
                "properties": {
                  "amount_usd": {
                    "properties": {
                      "value": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100000
                      }
                    }
                  },
                  "period": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "not": {
                          "const": "UNKNOWN"
                        }
                      }
                    }
                  },
                  "cash_schedule": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "not": {
                          "const": "UNKNOWN"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "legacyRow": {
      "type": "object",
      "required": [
        "medication_id",
        "label",
        "quote",
        "source_url",
        "capture_sha256",
        "captured_on",
        "month_1_basis"
      ],
      "not": {
        "required": [
          "price_kind"
        ]
      },
      "description": "Exact snapshot-bound v1 compatibility only. Semantic validator must compare the complete legacy subset with the pinned snapshot; this schema alone does not authorize a legacy row."
    }
  }
}
