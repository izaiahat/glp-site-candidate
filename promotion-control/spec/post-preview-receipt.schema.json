{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glp-post-preview-readonly-receipt-v1",
  "title": "GLP P1 post-preview read-only verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "deployment", "bindings", "route_statuses", "response_hashes", "effects", "production_baseline_unchanged", "verifier_mode"],
  "properties": {
    "schema": {"const": "glp-post-preview-readonly-receipt-v1"},
    "status": {"enum": ["PASS_READ_ONLY", "FAIL"]},
    "verifier_mode": {"enum": ["live_read_only_get_head", "offline_fixture"]},
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_id", "preview_url", "project", "branch", "environment", "release_manifest_sha256", "candidate_tree_sha256"],
      "properties": {
        "deployment_id": {"type": "string", "minLength": 8},
        "preview_url": {"type": "string", "pattern": "^https://[a-z0-9.-]+\\.glp-clinic-scout\\.pages\\.dev/?$"},
        "project": {"const": "glp-clinic-scout"},
        "branch": {"const": "glp-go1-20260724"},
        "environment": {"const": "preview"},
        "release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "bindings": {"type": "object", "required": ["required_runtime_binding", "binding_repair"], "properties": {"required_runtime_binding": {"const": "GLP_DB"}, "binding_repair": {"const": "CLICK_MAP->GLP_DB"}}},
    "route_statuses": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "integer", "minimum": 100, "maximum": 599}},
    "response_hashes": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "production_baseline_unchanged": {"const": true},
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "deployment", "dns", "indexation", "affiliate_activation", "capture_activation", "analytics_mutation", "email", "optimizer", "spend_usd"],
      "properties": {
        "methods": {"type": "array", "items": {"enum": ["GET", "HEAD"]}, "minItems": 1, "uniqueItems": true},
        "deployment": {"const": false}, "dns": {"const": false}, "indexation": {"const": false},
        "affiliate_activation": {"const": false}, "capture_activation": {"const": false},
        "analytics_mutation": {"const": false}, "email": {"const": false},
        "optimizer": {"const": false}, "spend_usd": {"const": 0}
      }
    },
    "failures": {"type": "array", "items": {"type": "string"}}
  }
}
